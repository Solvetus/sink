{
  // Solvetus instance of Sink: go.solvetus.com, main Solvetus Cloudflare account.
  // Ours alone: upstream's wrangler.jsonc is never edited, so "Sync fork" cannot
  // conflict. After a sync, diff upstream's wrangler.jsonc against this file for
  // new bindings (see SOLVETUS.md). Deployed ONLY by .github/workflows/deploy.yml.
  // Naming: sink-<subdomain>-<domain>-<resource> (Infrastructure Naming Standards).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink-go-solvetus",
  // Pinned (as in subsigno-COM-app): wrangler refuses a token from any other account,
  // so a resource can never again be created in the wrong one (D1 and KV Standard, section 1).
  "account_id": "668113a7c146c356b40a76cbe3343bfe",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  // The custom domain. Wrangler creates the (proxied) DNS record and the certificate. The hostname must
  // be free first: the old Switchy CNAME was deleted before this was deployed (cut-over, 2026-11-24).
  "routes": [{ "pattern": "go.solvetus.com", "custom_domain": true }],
  // Off: go.solvetus.com is live and verified (cut-over, 2026-11-24). The workers.dev URL would serve a second,
  // unprotected-by-domain copy of the Worker.
  "workers_dev": false,
  "preview_urls": false,
  // vars in this file are the single source of truth: a deploy replaces whatever
  // is set in the dashboard. Secrets (NUXT_SITE_TOKEN, NUXT_CF_API_TOKEN) are set
  // by hand in the Worker's Variables and Secrets and survive deploys.
  "keep_vars": false,
  "vars": {
    // Hard requirement: temporary redirects. Destinations change when affiliate
    // programmes approve, and a 301 would be cached by browsers for good.
    "NUXT_REDIRECT_STATUS_CODE": "302",
    "NUXT_REDIRECT_NO_STORE": "true",
    // The visitor's query string is never appended: the UTMs in the stored URL are final.
    "NUXT_REDIRECT_WITH_QUERY": "false",
    "NUXT_LINK_CACHE_TTL": "60",
    "NUXT_CASE_SENSITIVE": "false",
    // Root and unknown slugs go to the main site (the unknown-slug redirect is always 302).
    "NUXT_PUBLIC_HOME_URL": "https://solvetus.com/",
    "NUXT_NOT_FOUND_REDIRECT": "https://solvetus.com/",
    // Features we do not use. Per-link password, warning page, cloaking and OpenGraph
    // fields are rejected by scripts-solvetus/sync-links.mjs; there is no AI or R2 binding.
    "NUXT_PUBLIC_LINK_PROXY_ENABLED": "false",
    "NUXT_DISABLE_AUTO_BACKUP": "true",
    // Click analytics are ON, exactly as upstream ships them (decision 2026-11-23):
    // the dataset below is the ANALYTICS binding's dataset; the account id lets the
    // dashboard read it with the NUXT_CF_API_TOKEN secret (Account Analytics: Read).
    // Clicks Sink recognises as robots (verified bots, crawler/fetcher user agents, names with bot/spider) are
    // not written to analytics: cleaner real-visitor numbers and less data stored (decision 2026-11-24).
    "NUXT_DISABLE_BOT_ACCESS_LOG": "true",
    "NUXT_DATASET": "sink_go_solvetus_clicks",
    "NUXT_CF_ACCOUNT_ID": "668113a7c146c356b40a76cbe3343bfe",
    // Cloudflare Access protects /dashboard and /_docs only (never a short link). With both values
    // set, /api also accepts the Access login; the site token keeps working. AUD is added when the
    // Access application exists.
    "NUXT_CF_ACCESS_TEAM_DOMAIN": "https://solvetus.cloudflareaccess.com",
    // Application Audience (AUD) tag of the Access application sink-go-solvetus-dashboard. Not a secret.
    "NUXT_CF_ACCESS_AUD": "c2094b1530465a64dfdbd1c436095f7000b775be0f8f638735dfe47da8d32c1a"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "sink_go_solvetus_clicks" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "add6aa9708974b62a6541fdc9bc91dea" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink-go-solvetus-links",
      "database_id": "80590235-b19f-4a00-99e8-c9f689f8715f",
      "migrations_dir": "drizzle"
    }
  ],
  // Upstream's daily cron (backup + expired-link cleanup). Both are off here, so it no-ops.
  "triggers": { "crons": ["0 0 * * *"] },
  // Console logs only. Invocation logs are OFF: each records the full request,
  // including headers and the cf geo object, of every click, on top of what the
  // analytics dataset already holds (which the privacy policy discloses).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
